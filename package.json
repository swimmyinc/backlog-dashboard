{
  "name": "backlog-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run test:api && npm run test:ui",
    "check": "node --check worker.js && node --check store.js && node --check scripts/dev.mjs && npm run build && npm test",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply backlog-dashboard --local",
    "preview": "wrangler dev --local --var LOCAL_DEV:true",
    "test:api": "node --test tests/*.test.js",
    "test:ui": "vitest run tests/frontend.test.jsx --environment node"
  },
  "dependencies": {
    "jose": "6.2.12",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.106.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "29.1.1",
    "miniflare": "5.20261006.1-alpha",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  }
}
