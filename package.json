{
  "name": "backlog-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run db:migrate:local && wrangler dev --local --var LOCAL_DEV:true",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check script.js && node --check worker.js && node --check store.js && npm test",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply backlog-dashboard --local"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "miniflare": "5.20261006.1-alpha"
  }
}
